  "section_04_interface_operations": {
    "abc_class": "ExpeditionRuntimeStateStore",
    "operations_count": 11,
    "operations": [
      "create_state(expedition_id, initial_state) -> CasResult",
      "get_state(expedition_id) -> ReadResult",
      "compare_and_update(expedition_id, expected_state_version, expected_fencing_token, mutation) -> CasResult",
      "apply_event_once(expedition_id, event_id, event_type, source_adventurer_id, payload_hash, expected_state_version, expected_fencing_token, mutation) -> CasResult",
      "reserve_writer(expedition_id, writer_worker_id, lease_ttl_seconds=30) -> LeaseAcquireResult",
      "renew_writer_lease(expedition_id, lease_id, fencing_token, extend_seconds=30) -> LeaseAcquireResult",
      "release_writer(expedition_id, lease_id, fencing_token) -> CasResult",
      "expire_state(expedition_id) -> CasResult",
      "delete_state(expedition_id) -> CasResult",
      "get_version(expedition_id) -> ReadResult",
      "health_check() -> bool"
    ]
  },
  "section_05_state_schema": {
    "class_name": "ExpeditionRuntimeState (frozen dataclass)",
    "fields": [
      "expedition_id (PK, unique)",
      "state_version (int, monotonic, initial=1)",
      "created_at / updated_at / expires_at (ISO UTC)",
      "runtime_status (enum: active/completing/completed/cancelled/expired)",
      "owner_worker_or_lease_id (str|None)",
      "lease (WriterLease|None)",
      "loadout_snapshot_version (int, reserved for future RT2-A wiring)",
      "adventurer_class_states (tuple<(adventurer_id, AdventurerClassState)>)",
      "processed_event_keys (tuple<EventReceipt>, bounded ring MAX=500 default)",
      "last_event_sequence (int, monotonic per expedition, server-authoritative)",
      "fencing_token (int, monotonic, incremented on every new lease acquisition)"
    ],
    "immutability": "frozen dataclass · mutation via CAS + new instance"
  },
  "section_06_lease_schema": {
    "class_name": "WriterLease (frozen dataclass)",
    "fields": [
      "lease_id",
      "owner_id",
      "acquired_at",
      "expires_at",
      "renewed_at",
      "lease_version",
      "fencing_token"
    ],
    "fencing_semantic": "monotonic int · +1 on every new acquisition · preserved on renewal",
    "defaults_verbatim_b0q08": {
      "lease_duration_seconds": 30,
      "renewal_interval_seconds": 10,
      "grace_period_seconds": 5
    }
  },
  "section_07_cas_result_types": {
    "enum": "CasResultCode",
    "codes": [
      "SUCCESS",
      "STATE_VERSION_CONFLICT",
      "STALE_WRITER_REJECTED",
      "DEDUPLICATED_NO_OP",
      "EVENT_ID_PAYLOAD_MISMATCH",
      "OWNERSHIP_INVALID",
      "CAP_EXCEEDED",
      "LEASE_EXPIRED",
      "NOT_FOUND",
      "ALREADY_EXISTS"
    ],
    "result_dataclasses": [
      "CasResult",
      "LeaseAcquireResult",
      "ReadResult"
    ],
    "partial_mutation_policy": "FORBIDDEN (all-or-nothing per CAS)"
  },
  "section_08_event_receipt_schema": {
    "class_name": "EventReceipt (frozen dataclass)",
    "fields_verbatim_b0q06_minimum": [
      "event_id",
      "event_type",
      "source_adventurer_id",
      "payload_hash",
      "assigned_event_sequence",
      "result_code",
      "state_version_after",
      "processed_at"
    ],
    "dedup_key": "(expedition_id, event_id)",
    "retention": "aligned with state document lifetime",
    "bounded": true,
    "at_limit_behavior": "FAIL_CLOSED (CAP_EXCEEDED · no eviction during active expedition)"
  },
  "section_09_fake_store": {
    "class_name": "FakeExpeditionRuntimeStateStore",
    "implementation": "in-memory dict + asyncio.Lock (single-process)",
    "clock_injectable": true,
    "production_use_marker": "PRODUCTION_USE = 'FORBIDDEN' (module-level constant)",
    "assertion_at_construction": "assert PRODUCTION_USE == 'FORBIDDEN'"
  },
  "section_10_mongo_adapter": {
    "class_name": "MongoExpeditionRuntimeStateStore",
    "dependency_injection": "collection injected at constructor · raises ValueError if None",
    "cas_filter_verbatim": "{_id: expedition_id, state_version: expected_state_version, fencing_token: expected_fencing_token}",
    "atomic_primitive": "find_one_and_update with $inc {state_version:1} + $set mutation + $currentDate-equivalent updated_at ISO",
    "dedup_guard_in_apply_event_once": "processed_event_keys.event_id: {$ne: event_id} added to filter",
    "error_mapping": "any adapter-level exception → StoreInfraError",
    "runtime_instantiation": "NOT INSTANTIATED by application runtime (test-only path)",
    "direct_db_imports_count": 0,
    "direct_db_imports_verified_by_test": "test_no_direct_db_import_in_adapter (grep motor/pymongo = 0)"
  },
