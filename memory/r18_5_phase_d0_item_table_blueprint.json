  "sezione_1_schema_finale_item_table": {
    "target_collection_design_only": "items_r18_5",
    "note": "Blueprint schema — NOT created in DB, design layer only",
    "fields": {
      "item_id": {"type": "string uuid4", "unique": true, "public_reference": true},
      "item_slug": {"type": "string kebab-case", "unique": true},
      "name_it": {"type": "string", "constraint": "3-60 char"},
      "name_en": {"type": "string", "required": false},
      "description": {"type": "string"},
      "utility_text": {"type": "string"},
      "slot_type": {"type": "enum", "values": ["head", "chest", "legs", "hands", "feet", "main-hand", "off-hand", "ring", "amulet", "trinket", "consumable"]},
      "item_type": {"type": "enum", "values": ["armor", "weapon", "accessory", "consumable", "material", "quest", "cosmetic"]},
      "rarity": {"type": "enum", "values": ["common", "uncommon", "rare", "epic", "legendary"]},
      "tier": {"type": "int", "range": "1-5"},
      "ilvl": {"type": "int", "range": "1-60"},
      "main_stat": {"type": "enum", "values": ["STR", "AGI", "INT", "END", "FAI"]},
      "secondary_stats": {"type": "object", "note": "stat -> value map"},
      "armor_type": {"type": "enum | null", "values": ["light", "medium", "heavy", null]},
      "weapon_family": {"type": "enum | null", "values": ["sword", "dagger", "staff", "mace", "bow", "shield", "polearm", "wand", "hammer", "strumento", "falce", "trinket", null]},
      "source_dungeon_slug": {"type": "string | null"},
      "source_raid_slug": {"type": "string | null"},
      "source_type": {"type": "enum", "values": ["dungeon_drop", "raid_drop", "crafting", "achievement", "ranking", "quest", "world_boss", "vendor_special"]},
      "lore_source": {"type": "string referenced from lore_meta"},
      "class_proficiency": {"type": "array enum", "values_per_element": ["warrior", "rogue", "mage", "priest", "ranger"], "min_length": 1},
      "is_universal": {"type": "bool", "constraint": "XOR class_proficiency=[all 5]"},
      "drop_rate": {"type": "float", "range": "0.0-1.0"},
      "item_binding_policy": {"type": "enum", "values": ["bind-on-pickup", "bind-on-equip", "unbound"]},
      "is_tradeable": {"type": "bool"},
      "can_be_sold_for_gold": {"type": "bool"},
      "can_be_sold_for_real_money": {"type": "bool", "anti_p2w_R18_constraint": true},
      "is_cosmetic": {"type": "bool"},
      "affects_combat": {"type": "bool"},
      "affects_economy": {"type": "bool"},
      "affects_ranking": {"type": "bool"},
      "signature_capacity_slot": {"type": "bool"},
      "created_at_utc": {"type": "ISO string", "value": "datetime.now(timezone.utc)"},
      "updated_at_utc": {"type": "ISO string", "value": "datetime.now(timezone.utc)"}
    }
  },
